{
  "mcpServers": {
    "goland": {
      "url": "http://127.0.0.1:12345/sse",
      "timeout": 60
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "maple": {
      "url": "http://127.0.0.1:47321/mcp",
      "transportType": "streamable-http",
      "headers": {
        "Authorization": "Bearer test-token"
      }
    }
  }
}
